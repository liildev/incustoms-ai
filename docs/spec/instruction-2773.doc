d black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции по централизованной системе</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">04</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">5.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции по бартеру</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">05</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">6.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции по лизингу</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">06</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">7.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции по ввозу на таможенную территорию и помещение товаров в таможенные режимы «таможенный склад», «свободный склад» или «свободная таможенная зона», с целью их последующей продажи за рубеж</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">07</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">8.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции по оформлению в таможенный режим «реэкспорт» товаров, ввезенных на таможенную территорию и помещенных в таможенные режимы «таможенный склад», «свободный склад» или «свободная таможенная зона» на таможенной территории, с целью последующей продажи за рубеж</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">08</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">9.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции (услуги) по переработке, осуществляемые на таможенной территории по требованию зарубежного заказчика или вне таможенной территории по требованию резидента</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">09</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">10.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции по переработке, осуществляемые без требования зарубежного заказчика</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">10</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">11.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Операции (кооперация) по передаче товаров, переработанных на таможенной территории, для их дальнейшей переработки</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">11</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">12.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Торговые операции, не осуществляемые через коммерческие банки</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">12</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">13.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">Другие виды торговых операций</span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">13</span></span></p></td></tr><tr><td colspan="3" style="border-bottom:1px solid black; width:100%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><b><span style="color:black">Операции, не связанные с торговлей</span></b></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">1.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><strong><span style="font-weight:normal">Безвозмездная помощь и/или спонсорские операции</span></strong></span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">81</span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:5%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" style="text-align:center"><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif">2.</span></span></p></td><td style="border-bottom:1px solid black; width:86%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p><span style="font-size:12pt"><span style="font-family:"Times New Roman",serif"><strong><span style="font-weight:normal">Операции по технической помощи</span></strong></span></span></p></td><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; background-color:white; border-top:none; border-right:1px solid black; border-left:n